ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
ADMIN_COOKIE_SECURE=false
ADMIN_ALLOWED_HOSTS=*
HOMEPAGE_URL=http://10.10.1.11:3000
HOMEPAGE_HOST_CONFIG_DIR=/opt/docker/HomePage/data/config
HOMEPAGE_ADMIN_DATA_DIR=/opt/docker/homepage-admin/data
# Default backup retention. v0.2.3+ can override this from the Backup page.
BACKUP_LIMIT=50
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Shared read-only Docker API proxy (legacy/default endpoint).
# v0.4.1 also auto-discovers remote host/port entries from docker.yaml and supports extra Admin hosts in /data.
DOCKER_PUBLIC_HOST=10.10.1.11
DOCKER_SERVER_NAME=
HOMEPAGE_DOCKER_PROXY_HOST=homepage-docker-proxy
HOMEPAGE_DOCKER_PROXY_PORT=2375
DOCKER_HIDE_INTERNAL=true

# Homepage official Widget Schema synchronization defaults.
# These can be overridden at runtime from Widget Center -> Schema management.
WIDGET_SCHEMA_AUTO_SYNC=true
WIDGET_SCHEMA_SYNC_MODE=interval
WIDGET_SCHEMA_SYNC_INTERVAL_HOURS=24
WIDGET_SCHEMA_SYNC_TIME=03:00
WIDGET_SCHEMA_TIMEZONE=Asia/Shanghai
WIDGET_SCHEMA_REF=dev
WIDGET_SCHEMA_TIMEOUT=8
WIDGET_SCHEMA_WORKERS=10
