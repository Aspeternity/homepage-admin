# Homepage Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Browser / reverse-proxy settings
ADMIN_COOKIE_SECURE=false
ADMIN_ALLOWED_HOSTS=*
HOMEPAGE_URL=https://homepage.example.com
HOMEPAGE_ADMIN_PORT=3001

# Host paths mounted into Homepage Admin
HOMEPAGE_HOST_CONFIG_DIR=/opt/docker/HomePage/data/config
HOMEPAGE_ADMIN_DATA_DIR=/opt/docker/homepage-admin/data

# Container user. It must be able to read/write both mounted directories.
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Default backup retention. It can also be changed from the Backup page.
BACKUP_LIMIT=50

# Docker discovery is optional and is configured from docker.yaml / Docker Host Management.
# No shared Docker network or Docker socket mount is required for Homepage Admin.
DOCKER_HIDE_INTERNAL=true

# Homepage official Widget Schema synchronization defaults.
# These can be changed at runtime from Widget Center -> Schema management.
WIDGET_SCHEMA_AUTO_SYNC=true
WIDGET_SCHEMA_SYNC_MODE=interval
WIDGET_SCHEMA_SYNC_INTERVAL_HOURS=24
WIDGET_SCHEMA_SYNC_TIME=03:00
WIDGET_SCHEMA_TIMEZONE=Asia/Shanghai
WIDGET_SCHEMA_REF=dev
WIDGET_SCHEMA_TIMEOUT=8
WIDGET_SCHEMA_WORKERS=10
