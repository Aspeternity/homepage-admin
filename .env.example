# Homepage Admin v0.5.3 does not require an .env file for normal deployment.
# The administrator account and session secret are created automatically on first run
# and stored in /data/auth.json.
#
# The variables below are OPTIONAL advanced overrides. Add only what you actually need.

# HOMEPAGE_URL=https://homepage.example.com
# ADMIN_COOKIE_SECURE=true
# ADMIN_ALLOWED_HOSTS=admin.example.com
# BACKUP_LIMIT=50
# DOCKER_HIDE_INTERNAL=true
# TZ=UTC

# Widget Schema defaults (also configurable from the web UI)
# WIDGET_SCHEMA_AUTO_SYNC=true
# WIDGET_SCHEMA_SYNC_MODE=interval
# WIDGET_SCHEMA_SYNC_INTERVAL_HOURS=24
# WIDGET_SCHEMA_SYNC_TIME=03:00
# WIDGET_SCHEMA_TIMEZONE=UTC
# WIDGET_SCHEMA_REF=dev

# Legacy compatibility only. New deployments should NOT put credentials in Compose.
# Existing v0.5.2-and-earlier installs may keep these temporarily; v0.5.3 migrates
# them into /data/auth.json so they can be removed after the first successful start.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=
# SESSION_SECRET=
