# Web login
ADMIN_USERNAME=admin
# Recommended: use ADMIN_PASSWORD_HASH and leave ADMIN_PASSWORD empty.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH='$2b$12$REPLACE_WITH_A_BCRYPT_HASH'

# Generate with: docker compose run --rm homepage-admin python -m app.hash_password
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
ADMIN_COOKIE_SECURE=false
ADMIN_ALLOWED_HOSTS=10.10.1.11,homepage-admin.aspandre.cn,localhost

# Homepage and storage
HOMEPAGE_URL=https://homepage.aspandre.cn
HOMEPAGE_CONFIG_DIR=/config
ADMIN_DATA_DIR=/data
BACKUP_LIMIT=50
TZ=Asia/Shanghai

# Host permissions. Use the UID/GID that owns your Homepage config directory.
PUID=1000
PGID=1000
